{
  "manifest_version": 3,
  "name": "Flow Reference Studio",
  "version": "0.2.0",
  "description": "Prepare references and prompts, drive Google Flow from a content script, and verify local region edits.",
  "permissions": ["storage", "sidePanel", "activeTab", "tabs", "alarms"],
  "host_permissions": ["https://flow.google.com/*", "http://127.0.0.1:8200/*"],
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["content-flow.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Open Flow Reference Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
